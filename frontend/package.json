{
  "name": "cmutuneit-extension",
  "productName": "CMUTuneIt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/extract-cars.mjs && node scripts/make-icons.mjs",
    "desktop": "vite build && electron .",
    "desktop:dev": "NOVA_DEV_URL=http://localhost:5173/widget.html electron .",
    "desktop:bundle": "npm run build && node scripts/package-desktop.cjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "main": "desktop/main.cjs"
}
