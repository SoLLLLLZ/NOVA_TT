#!/bin/sh
set -eu
NOVA_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${1:-}" != run ]; then
  echo "Usage: ./scripts/tuneit run [qwen3.8-27b|muse-glimmer|qwen3.8-flash-next]" >&2
  exit 2
fi
shift
NOVA_MODEL=${1:-qwen3.8-27b}
if [ "$#" -gt 0 ]; then shift; fi
exec "$NOVA_ROOT/.venv/bin/python" "$NOVA_ROOT/scripts/generate.py" --model "$NOVA_MODEL" --interactive "$@"
